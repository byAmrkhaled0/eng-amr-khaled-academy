# Optional Judge0 provider settings. Copy only to your local functions/.env.
# Never commit credentials. The local review demo disables code execution.
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_KEY_HEADER=X-Auth-Token
JUDGE0_RAPIDAPI_HOST=

# Exact approved origins, comma-separated. ce.judge0.com is approved by default.
JUDGE0_ALLOWED_ORIGINS=
# Keep false unless intentionally using an approved private self-hosted endpoint.
JUDGE0_ALLOW_PRIVATE_ENDPOINT=false
# Default 128, bounded 64..256. Provider compatibility must be tested separately.
CODE_MAX_PROCESSES=128
# Per-IP minute budget (20..120); visitor ID is not authentication.
CODE_IP_RUNS_PER_MINUTE=60
