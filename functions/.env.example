# Optional Judge0 configuration
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_KEY_HEADER=X-Auth-Token
JUDGE0_RAPIDAPI_HOST=

# Custom Judge0 requires exact approved origin(s), comma-separated. Default ce.judge0.com is approved.
JUDGE0_ALLOWED_ORIGINS=
# Only for an intentionally private self-hosted endpoint also named above; never client-controlled.
JUDGE0_ALLOW_PRIVATE_ENDPOINT=false
# Verified Hello compatibility for all 12 languages at 128. Bounded 64..256.
CODE_MAX_PROCESSES=128
# Per-IP minute budget (20..120); per IP+visitor remains 6. Visitor is not authentication.
CODE_IP_RUNS_PER_MINUTE=60
